{
  "name": "@paymos/mcp",
  "version": "1.0.1",
  "description": "Official Paymos MCP server: a local stdio server that lets coding agents (Claude Code, Cursor, custom LLM bots) build and verify a merchant integration against the Paymos sandbox without reading docs.",
  "keywords": [
    "paymos",
    "mcp",
    "model-context-protocol",
    "payments",
    "stablecoins",
    "usdt",
    "usdc",
    "crypto",
    "claude",
    "cursor",
    "agent"
  ],
  "homepage": "https://paymos.io/docs/mcp",
  "bugs": {
    "url": "https://github.com/paymos-labs/mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paymos-labs/mcp.git"
  },
  "license": "MIT",
  "author": "Paymos Labs <support@paymos.io>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "bin": {
    "paymos-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:resources && tsup src/index.ts --format esm --dts --clean",
    "build:resources": "node scripts/generate-resources.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@paymos/sdk": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
