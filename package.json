{
  "name": "@paymos/mcp",
  "mcpName": "io.paymos/mcp",
  "version": "1.12.1",
  "description": "Official Paymos MCP server and multi-AI plugin wrapper (Claude Code, OpenAI Codex, Antigravity, Gemini CLI, GitHub Copilot CLI, Cursor, Agent Skills): remote OAuth 2.1 Merchant MCP with 188 workspace and Sandbox tools, plus local stdio bridge with offline docs, integration advisor, and key-based Sandbox.",
  "keywords": [
    "paymos",
    "mcp",
    "model-context-protocol",
    "payments",
    "stablecoins",
    "usdt",
    "usdc",
    "crypto",
    "claude",
    "cursor",
    "agent"
  ],
  "homepage": "https://paymos.io/docs/mcp",
  "bugs": {
    "url": "https://github.com/Paymos-labs/mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paymos-labs/mcp.git"
  },
  "license": "MIT",
  "author": "Paymos Labs <support@paymos.io>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "bin": {
    "paymos": "./dist/index.js",
    "paymos-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build:resources && tsup src/index.ts --format esm --dts --clean",
    "build:resources": "node scripts/generate-resources.mjs && node scripts/generate-merchant-tools.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "verify:local": "node scripts/verify-local-setup.mjs",
    "prepack": "npm run build && npm run check && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@paymos/sdk": "^2.7.1",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.12",
    "vite": "^6.4.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
